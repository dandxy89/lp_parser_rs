{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LP",
  "scopeName": "source.lp",
  "fileTypes": [
    "lp"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lp",
          "begin": "\\\\\\*",
          "end": "\\*\\\\",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lp"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lp"
            }
          }
        },
        {
          "name": "comment.line.backslash.lp",
          "match": "(\\\\).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.lp"
            }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "comment": "Objective sense: first token of a line.",
          "match": "(?i)^\\s*(minimi[sz]e|minimum|min|maximi[sz]e|maximum|max)(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])",
          "captures": {
            "1": {
              "name": "keyword.control.sense.lp"
            }
          }
        },
        {
          "comment": "Multi-word section headers.",
          "match": "(?i)(?<![A-Za-z0-9_!#$%&.;?@{}~'|])(subject[ \\t]+to|such[ \\t]+that|lazy[ \\t]+constraints|user[ \\t]+cuts|general[ \\t]+constraints?|general[ \\t]+constrs?|gen[ \\t]+cons|multi-objectives?)(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])",
          "captures": {
            "1": {
              "name": "keyword.control.section.lp"
            }
          }
        },
        {
          "comment": "`s.t.` anywhere; `st` only as the first token of a line.",
          "match": "(?i)(?<![A-Za-z0-9_!#$%&.;?@{}~'|])(s\\.t\\.)|^\\s*(st)(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])",
          "captures": {
            "1": {
              "name": "keyword.control.section.lp"
            },
            "2": {
              "name": "keyword.control.section.lp"
            }
          }
        },
        {
          "comment": "Single-word section keywords: first token of a line and not followed by `:`.",
          "match": "(?i)^\\s*(bounds?|generals?|gen|integers?|binary|binaries|bin|semi-continuous|semis?|sos|genconstrs?|end)(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])(?!\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.control.section.lp"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.free.lp",
          "match": "(?i)(?<![A-Za-z0-9_!#$%&.;?@{}~'|])free(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])"
        },
        {
          "name": "support.type.sos.lp",
          "match": "(?i)(?<![A-Za-z0-9_!#$%&.;?@{}~'|])s[12](?=\\s*::)"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "comment": "Constraint, objective and SOS names: `name:` at the start of a line.",
          "match": "^\\s*([A-Za-z_!#$%&.;?@{}~'][A-Za-z0-9_!#$%&.;?@{}~'|\\-]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "entity.name.label.lp"
            },
            "2": {
              "name": "punctuation.separator.label.lp"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.infinity.lp",
          "match": "(?i)(?<![A-Za-z0-9_!#$%&.;?@{}~'|])inf(inity)?(?![A-Za-z0-9_!#$%&.;?@{}~'|\\-])"
        },
        {
          "name": "constant.numeric.lp",
          "match": "(?<![A-Za-z0-9_!#$%&.;?@{}~'|])([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.indicator.lp",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.lp",
          "match": "<=|=<|>=|=>|<|>|="
        },
        {
          "name": "punctuation.separator.sos.lp",
          "match": "::"
        },
        {
          "name": "keyword.operator.arithmetic.lp",
          "match": "[+\\-*/^]"
        }
      ]
    }
  }
}
