{
  "name": "lp-lsp",
  "displayName": "LP & MPS Language Server",
  "description": "Language support for LP (linear programming) files, powered by the lp-lsp language server.",
  "version": "1.0.2",
  "publisher": "dandxy89",
  "icon": "images/icon.png",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dandxy89/lp_parser_rs",
    "directory": "lsp/editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/dandxy89/lp_parser_rs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "homepage": "https://github.com/dandxy89/lp_parser_rs/tree/main/lsp",
  "keywords": [
    "lp",
    "linear programming",
    "optimisation",
    "cplex",
    "gurobi"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode only the language server and solver helper bundled with the extension run; `lp.server.path`, `lp.solver.path` and `PATH` are not used.",
      "restrictedConfigurations": ["lp.server.path", "lp.solver.path"]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "lp",
        "aliases": [
          "LP",
          "Linear Programming",
          "lp"
        ],
        "extensions": [
          ".lp",
          ".LP",
          ".Lp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lp",
        "scopeName": "source.lp",
        "path": "./syntaxes/lp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lp",
        "path": "./snippets/lp.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lp",
          "title": "LP",
          "icon": "images/lp-activity.svg"
        }
      ]
    },
    "views": {
      "lp": [
        {
          "id": "lp.modelExplorer",
          "name": "Model Explorer",
          "contextualTitle": "LP Model Explorer"
        },
        {
          "id": "lp.analysis",
          "name": "Analysis",
          "contextualTitle": "LP Analysis"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lp.modelExplorer",
        "contents": "The language server does not advertise `lp/model`. Update `lp-lsp` and restart the server.\n[Restart Language Server](command:lp.restartServer)",
        "when": "!lp.supports.model"
      },
      {
        "view": "lp.analysis",
        "contents": "Open an LP file to see its analysis findings grouped by category.",
        "when": "activeEditor == null || editorLangId != lp"
      }
    ],
    "commands": [
      {
        "command": "lp.explorer.refresh",
        "title": "Refresh Model Explorer",
        "category": "LP",
        "icon": "$(refresh)",
        "enablement": "lp.supports.model"
      },
      {
        "command": "lp.explorer.filter",
        "title": "Filter Model Explorer",
        "category": "LP",
        "icon": "$(filter)",
        "enablement": "lp.supports.model"
      },
      {
        "command": "lp.explorer.clearFilter",
        "title": "Clear Model Explorer Filter",
        "category": "LP",
        "icon": "$(clear-all)",
        "enablement": "lp.supports.model"
      },
      {
        "command": "lp.revealRange",
        "title": "Go to Source",
        "category": "LP"
      },
      {
        "command": "lp.analyze",
        "title": "Analyse Model",
        "category": "LP"
      },
      {
        "command": "lp.convertToMps",
        "title": "Convert to MPS",
        "category": "LP"
      },
      {
        "command": "lp.showModelStats",
        "title": "Show Model Statistics",
        "category": "LP"
      },
      {
        "command": "lp.restartServer",
        "title": "Restart Language Server",
        "category": "LP"
      },
      {
        "command": "lp.solve",
        "title": "Solve Model",
        "category": "LP",
        "enablement": "lp.supports.solve"
      },
      {
        "command": "lp.showModelExplorer",
        "title": "Show Model Explorer",
        "category": "LP",
        "enablement": "lp.supports.model"
      },
      {
        "command": "lp.showMatrix",
        "title": "Show Coefficient Matrix",
        "category": "LP",
        "enablement": "lp.supports.matrix"
      },
      {
        "command": "lp.showDependencyGraph",
        "title": "Show Dependency Graph",
        "category": "LP",
        "enablement": "lp.supports.graph"
      },
      {
        "command": "lp.compareModels",
        "title": "Compare Models",
        "category": "LP",
        "enablement": "lp.supports.diff"
      },
      {
        "command": "lp.explainConstraint",
        "title": "Explain Constraint",
        "category": "LP",
        "enablement": "lp.supports.explain"
      },
      {
        "command": "lp.explainVariable",
        "title": "Explain Variable",
        "category": "LP",
        "enablement": "lp.supports.explain"
      },
      {
        "command": "lp.diagnoseInfeasibility",
        "title": "Diagnose Infeasibility",
        "category": "LP",
        "enablement": "lp.supports.solve"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lp.explorer.filter",
          "when": "view == lp.modelExplorer",
          "group": "navigation@1"
        },
        {
          "command": "lp.explorer.clearFilter",
          "when": "view == lp.modelExplorer",
          "group": "navigation@2"
        },
        {
          "command": "lp.explorer.refresh",
          "when": "view == lp.modelExplorer",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "lp.revealRange",
          "when": "false"
        },
        {
          "command": "lp.explorer.refresh",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.explorer.filter",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.explorer.clearFilter",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.analyze",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.convertToMps",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.showModelStats",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.solve",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.showModelExplorer",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.showMatrix",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.showDependencyGraph",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.compareModels",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.explainConstraint",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.explainVariable",
          "when": "editorLangId == lp"
        },
        {
          "command": "lp.diagnoseInfeasibility",
          "when": "editorLangId == lp"
        }
      ],
      "editor/context": [
        {
          "command": "lp.explainConstraint",
          "when": "editorLangId == lp && lp.supports.explain",
          "group": "lp@1"
        },
        {
          "command": "lp.explainVariable",
          "when": "editorLangId == lp && lp.supports.explain",
          "group": "lp@2"
        }
      ]
    },
    "configuration": {
      "title": "LP",
      "properties": {
        "lp.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `lp-lsp` binary. Empty: use the server bundled with the extension, falling back to `PATH`. Install separately with `cargo install --locked lp-lsp`.",
          "scope": "machine"
        },
        "lp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the LP language server."
        },
        "lp.analysis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish analysis issues as diagnostics."
        },
        "lp.analysis.largeCoefficientThreshold": {
          "type": "number",
          "default": 1000000000,
          "description": "Coefficients above this magnitude are flagged."
        },
        "lp.analysis.smallCoefficientThreshold": {
          "type": "number",
          "default": 1e-09,
          "description": "Non-zero coefficients below this magnitude are flagged."
        },
        "lp.analysis.largeRhsThreshold": {
          "type": "number",
          "default": 1000000000,
          "description": "RHS values above this magnitude are flagged."
        },
        "lp.analysis.coefficientRatioThreshold": {
          "type": "number",
          "default": 1000000,
          "description": "Max/min coefficient ratio above which scaling is flagged."
        },
        "lp.analysis.heuristics": {
          "type": "boolean",
          "default": true,
          "description": "Publish heuristic findings: smells that are often mistakes but sometimes intended (for example badly scaled coefficients). Proven findings are unaffected. A code listed in lp.analysis.severityOverrides is published regardless."
        },
        "lp.analysis.categories": {
          "type": "object",
          "default": {
            "structural": true,
            "numerical": true,
            "mathematical": true,
            "performance": true
          },
          "additionalProperties": false,
          "properties": {
            "structural": {
              "type": "boolean",
              "default": true,
              "description": "Redundant, duplicate and unused model elements."
            },
            "numerical": {
              "type": "boolean",
              "default": true,
              "description": "Badly scaled coefficients and right-hand sides."
            },
            "mathematical": {
              "type": "boolean",
              "default": true,
              "description": "Infeasible, contradictory or unbounded formulations."
            },
            "performance": {
              "type": "boolean",
              "default": true,
              "description": "Notes about the analysis itself, such as truncation."
            }
          },
          "markdownDescription": "Which categories of model diagnostics are published. A code listed in `lp.analysis.severityOverrides` is published regardless."
        },
        "lp.analysis.severityOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "invalid-bounds": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "negative-upper-default-lower": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "integer-no-feasible-values": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "integer-fractional-bound": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "semi-integer-only-zero": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "binary-bound-outside-unit": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "binary-redundant-bounds": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "integer-is-binary": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "semicontinuous-infinite-upper": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "fixed-variable": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "unused-variable": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "objective-only-variable": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "no-effective-bound": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "nonconvex-objective": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "empty-objective": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "duplicate-objective": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "opposed-objectives": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "empty-row-infeasible": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "empty-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "explicit-zero-coefficient": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "repeated-variable-in-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "singleton-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "row-infeasible-by-bounds": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "row-redundant-by-bounds": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "duplicate-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "proportional-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "dominated-row": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "contradictory-rows": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "rows-form-range": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "equalities-exceed-variables": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "large-coefficient": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "small-coefficient": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "large-rhs": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "row-coefficient-range": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "column-coefficient-range": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "objective-coefficient-range": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "coefficient-range": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "rhs-coefficient-ratio": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "indicator-not-binary": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "sos-duplicate-weights": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "sos-trivial": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            },
            "diagnostics-truncated": {
              "type": "string",
              "enum": ["error", "warning", "information", "hint", "off"]
            }
          },
          "markdownDescription": "Severity per model diagnostic code, or `off` to hide it. An entry other than `off` also overrides `lp.analysis.heuristics` and `lp.analysis.categories` for that code."
        },
        "lp.analysis.feasibilityTolerance": {
          "type": "number",
          "default": 1e-06,
          "minimum": 0,
          "description": "Slack before a bound or row violation is reported as proven."
        },
        "lp.analysis.equalityTolerance": {
          "type": "number",
          "default": 1e-09,
          "minimum": 0,
          "description": "Relative tolerance for two normalised coefficients to count as equal."
        },
        "lp.analysis.rhsCoefficientRatioThreshold": {
          "type": "number",
          "default": 1000000000,
          "exclusiveMinimum": 0,
          "description": "|rhs| / largest |coefficient| in a row above which the ratio is flagged."
        },
        "lp.analysis.maxPerCode": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "description": "Diagnostics published per code before the rest are summarised."
        },
        "lp.solver.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path of the lp-highs solver helper. Empty searches next to the language server, then PATH."
        },
        "lp.solver.timeLimit": {
          "type": "number",
          "default": 60,
          "exclusiveMinimum": 0,
          "description": "Wall-clock limit for one solve, in seconds."
        },
        "lp.solution.inlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show solution values as inlay hints after a solve."
        },
        "lp.solution.showStale": {
          "type": "boolean",
          "default": false,
          "description": "Keep showing a solution after the document has changed."
        },
        "lp.semantic.maxFileSizeMb": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "description": "Above this size (in MB) the semantic pass only runs on save."
        },
        "lp.semantic.debounceMs": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "description": "Delay (in milliseconds) after the last edit before the semantic pass runs."
        },
        "lp.format.indent": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 16,
          "description": "Body indent in spaces."
        },
        "lp.format.lineWidth": {
          "type": "integer",
          "default": 100,
          "minimum": 20,
          "description": "Wrap expressions longer than this."
        },
        "lp.format.alignOperators": {
          "type": "boolean",
          "default": false,
          "description": "Align comparison operators within a section."
        },
        "lp.format.keywordCase": {
          "type": "string",
          "enum": [
            "preserve",
            "lower",
            "upper",
            "title"
          ],
          "enumDescriptions": [
            "Keep keywords as written.",
            "`subject to`",
            "`SUBJECT TO`",
            "`Subject To`"
          ],
          "default": "preserve",
          "description": "Keyword casing."
        },
        "lp.codeLens.actions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **Solve** on the objective and **Explain** on each named constraint as code lenses."
        },
        "lp.inlayHints.generatedNames": {
          "type": "boolean",
          "default": true,
          "description": "Show generated names for unnamed constraints and objectives."
        },
        "lp.inlayHints.rangePartners": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the `_rng` partner of ranged constraints."
        },
        "lp.inlayHints.variableTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the variable type after a variable's first use."
        },
        "lp.inlayHints.normalisedRhs": {
          "type": "boolean",
          "default": true,
          "description": "Show the normalised RHS when constants appear on the left-hand side."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./ && tsc --noEmit -p tsconfig.webviews.json",
    "build:webviews": "esbuild src/webviews/matrix.ts src/webviews/graph.ts src/webviews/diff.ts src/webviews/solution.ts src/webviews/explain.ts --bundle --format=iife --target=es2022 --platform=browser --outdir=dist/webviews",
    "compile": "npm run check-types && esbuild src/extension.ts --bundle --format=cjs --platform=node --external:vscode --outfile=dist/extension.js --sourcemap && npm run build:webviews",
    "watch": "esbuild src/extension.ts --bundle --format=cjs --platform=node --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "vscode:prepublish": "npm run check-types && esbuild src/extension.ts --bundle --format=cjs --platform=node --external:vscode --outfile=dist/extension.js --minify && npm run build:webviews -- --minify",
    "package": "vsce package",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "test:integration": "npm run compile && tsc -p tsconfig.integration.json && node out/integration/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "mocha": "^12.0.3",
    "ovsx": "1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
