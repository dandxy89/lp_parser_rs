# Shared settings, sourced by every scene. Render all: ./render.sh
Set Shell "bash"
Set FontSize 20
Set Width 1400
Set Height 760
Set Padding 28
Set Theme "Catppuccin Mocha"
Set CursorBlink false
Set TypingSpeed 40ms
Hide
Type "cd ../demo && export PATH=$HOME/.cargo/target-shared/release:$HOME/.cargo/bin:$PATH PS1='\[\e[35m\]❯\[\e[0m\] ' && clear"
Enter
Show
